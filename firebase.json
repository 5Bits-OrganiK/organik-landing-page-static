{
  "hosting": {
    "site": "organik-d6e58",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "**/.git/**",
      "**/node_modules/**",
      "**/*.md",
      ".editorconfig",
      ".prettierrc"
    ],
    "redirects": [
      {
        "source": "/login",
        "destination": "https://organik-app-d6e58.web.app/login",
        "type": 302
      },
      {
        "source": "/register",
        "destination": "https://organik-app-d6e58.web.app/register",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|svg|jpg|png|webp|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  }
}
